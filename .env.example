# Copy to .env and fill in. .env is gitignored — never commit a real token.

# From @BotFather
TG_TOKEN=123456789:AA...

# Library root as the *bot* sees it. docker-compose overrides this with /media,
# so a checkout can be run directly with a host path here.
OUTPUT_FOLDER=/media

# Host path bind-mounted at /media by docker-compose.
LIBRARY_PATH=/home/netbug/media
# Host directory for logs, bind-mounted at /var/log/tgmusicbot.
LOG_DIR=/var/log/tgmusicbot

# Numeric Telegram user ids allowed to write to the library. Mandatory:
# without it anyone who finds the bot can write to the collection.
TG_ALLOWED_USERS=

# Optional
LOG_PATH=/tmp/log/tgmusicbot.log
WORKERS=2
MAX_UPLOAD_MB=200
PROGRESS_INTERVAL_S=3
JOB_TTL_S=3600
SEARCH_LIMIT=5
MIN_DURATION_S=30
MAX_DURATION_S=1200
# Enables remuxing WebM/Opus into Ogg. Auto-detected on PATH when unset;
# without ffmpeg the bot takes m4a instead of WebM.
FFMPEG_PATH=
# YouTube answers datacentre IPs with "Sign in to confirm you're not a bot".
# A Netscape cookie jar exported from a logged-in browser is the documented fix.
YT_COOKIES_FILE=
# Comma-separated yt-dlp extractor clients, e.g. web_safari,ios. Empty = default.
YT_PLAYER_CLIENTS=
# Rootless podman maps container uid 1000 to a subuid, so bind mounts are not
# writable without keep-id. Leave empty under Docker.
USERNS_MODE=
