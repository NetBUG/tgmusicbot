# Copy to .env and fill in. .env is gitignored — never commit a real token.

# From @BotFather
TG_TOKEN=123456789:AA...

# Library root. Inside the container this is the bind mount target.
OUTPUT_FOLDER=/media

# Numeric Telegram user ids allowed to write to the library. Mandatory:
# without it anyone who finds the bot can write to the collection.
TG_ALLOWED_USERS=

# Optional
LOG_PATH=/tmp/log/tgmusicbot.log
WORKERS=2
MAX_UPLOAD_MB=200
PROGRESS_INTERVAL_S=3
JOB_TTL_S=3600
